

/* Container */
#container {
    padding: 10px;
}

/* Section Styles */
.section {
    margin-bottom: 20px;
}

.section-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
    background-color: #3c3c3c;
    padding: 8px 12px;
    border-radius: 3px 3px 0 0;
    margin-bottom: 0;
}

.content-box {
    background-color: #2d2d2d;
    border-color:  #3c3c3c;
    border-width: 1px;
    border-radius: 0 0 3px 3px;
    padding: 10px;
}

/* Property Field Styles */
PropertyField {
    margin-bottom: 8px;
}



/* Label Styles */
.paths-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #cccccc;
    margin-bottom: 8px;
}

.path-label {
    font-size: 11px;
    color: #999999;
    margin-bottom: 4px;
    
}

/* Button Container */
.button-container {
    margin-top: 20px;
}

/* Action Button Styles */
.action-button {
    height: 30px;
    margin-bottom: 8px;
    background-color: #4a4a4a;
    border-color: #5c5c5c;
    color: #ffffff;
    font-size: 12px;
}

.action-button:hover {
    background-color: #5a5a5a;
    border-color: #6c6c6c;
}

.action-button:active {
    background-color: #3a3a3a;
    border-color: #4c4c4c;
}

/* Validate Button Styles */
.validate-button {
    height: 30px;
    background-color: #2d6a4f;
    border-color: #40916c;
    color: #ffffff;
    font-size: 12px;
   -unity-font-style: bold;
}

.validate-button:hover {
    background-color: #40916c;
    border-color: #52b788;
}

.validate-button:active {
    background-color: #1b4332;
    border-color: #2d6a4f;
}

/* ScrollView Styles */
ScrollView {
    background-color: #1e1e1e;
}

/* HelpBox Styles */
HelpBox {
    margin-bottom: 10px;
}

/* Toggle Styles */
Toggle {
    margin-bottom: 8px;
}

/* EnumField Styles */
EnumField {
    margin-bottom: 8px;
}

/* IntegerField Styles */
IntegerField {
    margin-bottom: 8px;
}

/* TextField Styles */
TextField {
    margin-bottom: 8px;
}

/* Array Styles */
ArrayField {
    margin-bottom: 8px;
}



/* Dark Theme Specifics */
UnityEditor.EditorWindow {
    background-color: #1e1e1e;
}

/* Section Hover Effects */
.content-box:hover {
    border-color: #5c5c5c;
}

/* Button Focus States */
.action-button:focus {
    border-color: #0a84ff;
}

.validate-button:focus {
    border-color: #0a84ff;
}

/* Label Truncation */
.path-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* Section Content Padding */
.content-box > PropertyField {
    margin-left: 0;
    margin-right: 0;
}



