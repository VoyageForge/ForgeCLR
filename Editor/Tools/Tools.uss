.ToolContainer {
    width: 100%;
    height: 100%;
    background-color: rgb(26, 26, 26);
    flex-direction: row;
    flex-wrap: wrap;
    flex-basis: auto;
    flex-shrink: 1;
    flex-grow: 1;
}

.DefaultBGColor {
    background-color: rgb(21, 21, 21);
    border-width: 2px;
    border-radius: 10px;
}

.leftPanel {
    min-width: 200px;
    height: 100%;
    border-width: 10px;
}

.rightPanel {
    min-width: 500px;
    height: 100%;
    border-width: 10px;
}

.leftPanel > .body {
    width: 100%;
    height: 100%;
    margin: 10px;
}

.borderColor {
    border-color: rgb(36, 35, 36);
}

.leftHeader {
    font-size: 20px;
    color: rgb(255, 255, 255);
    min-height: 40px;
    width: 100%;
    border-bottom-width: 2px;
}
